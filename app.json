{
  "expo": {
    "name": "Vibe Frontend Preview",
    "slug": "vibe-frontend",
    "scheme": "vibe",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Το Vibe ζητά την τοποθεσία σου μόνο για να προτείνει τις 7 κοντινότερες περιοχές κατά την εγγραφή."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vibe to choose a photo for your local profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.vibe.preview"
    },
    "ios": {
      "bundleIdentifier": "com.vibe.preview"
    }
  }
}
